// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MODÈLE UTILISATEUR
// ============================================
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  fullName      String    @map("full_name")
  
  // 2FA (Two-Factor Authentication)
  totpSecret    String?   @map("totp_secret")
  totpEnabled   Boolean   @default(false) @map("totp_enabled")
  
  // Rôle et statut
  role          Role      @default(USER)
  isBlocked     Boolean   @default(false) @map("is_blocked")
  
  // Dates
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  ownedDocuments    Document[]   @relation("DocumentOwner")
  ownedFolders      Folder[]     @relation("FolderOwner")
  permissions       Permission[]
  sessions          Session[]
  grantedPermissions Permission[] @relation("PermissionGranter")

  @@map("users")
}

// ============================================
// MODÈLE DOCUMENT
// ============================================
model Document {
  id            String    @id @default(uuid())
  title         String
  type          DocumentType
  
  // Relations
  ownerId       String    @map("owner_id")
  owner         User      @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  folderId      String?   @map("folder_id")
  folder        Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  
  // Contenu
  content       String?   @db.Text  // État Yjs en JSON pour documents textuels
  filePath      String?   @map("file_path")  // Chemin pour fichiers binaires (PDF, images)
  
  // Métadonnées
  isDeleted     Boolean   @default(false) @map("is_deleted")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  permissions   Permission[]
  versions      DocumentVersion[]

  @@index([ownerId])
  @@index([folderId])
  @@index([updatedAt])
  @@map("documents")
}

// ============================================
// MODÈLE DOSSIER
// ============================================
model Folder {
  id            String    @id @default(uuid())
  name          String
  
  // Relations hiérarchiques
  parentId      String?   @map("parent_id")
  parent        Folder?   @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      Folder[]  @relation("FolderHierarchy")
  
  // Propriétaire
  ownerId       String    @map("owner_id")
  owner         User      @relation("FolderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Dates
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  documents     Document[]

  @@index([ownerId])
  @@index([parentId])
  @@map("folders")
}

// ============================================
// MODÈLE PERMISSION
// ============================================
model Permission {
  id            String      @id @default(uuid())
  
  // Relations
  documentId    String      @map("document_id")
  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Niveau d'accès
  accessLevel   AccessLevel @map("access_level")
  
  // Qui a accordé cette permission
  grantedBy     String?     @map("granted_by")
  granter       User?       @relation("PermissionGranter", fields: [grantedBy], references: [id], onDelete: SetNull)
  
  // Date
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
  @@map("permissions")
}

// ============================================
// MODÈLE SESSION (pour les refresh tokens)
// ============================================
model Session {
  id            String    @id @default(uuid())
  
  // Utilisateur
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Token de rafraîchissement
  refreshToken  String    @map("refresh_token") @db.Text
  
  // Informations de connexion
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent") @db.Text
  
  // Expiration
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================
// MODÈLE VERSION DE DOCUMENT (optionnel)
// ============================================
model DocumentVersion {
  id              String    @id @default(uuid())
  
  // Document parent
  documentId      String    @map("document_id")
  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Contenu de cette version
  content         String    @db.Text
  versionNumber   Int       @map("version_number")
  
  // Qui a créé cette version
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([documentId])
  @@map("document_versions")
}

// ============================================
// ÉNUMÉRATIONS
// ============================================

// Rôle utilisateur
enum Role {
  USER    // Utilisateur standard
  ADMIN   // Administrateur (peut bloquer des users, gérer tout)
}

// Type de document
enum DocumentType {
  TEXT    // Document textuel (éditable avec Yjs)
  PDF     // Fichier PDF uploadé
  IMAGE   // Image uploadée
}

// Niveau d'accès aux documents
enum AccessLevel {
  READ    // Lecture seule
  WRITE   // Lecture + modification
  ADMIN   // Lecture + modification + gestion des permissions
}